{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User Sign In response",
  "type": "object",
  "required": ["token", "type", "userId", "email", "roles", "status", "passwordExpired"],
  "properties": {
    "token":           { "type": "string", "minLength": 1 },
    "type":            { "type": "string" },
    "userId":          { "type": "string" },
    "email":           { "type": "string" },
    "roles":           { "type": "array", "items": { "type": "string" } },
    "status":          { "type": "string" },
    "passwordExpired": { "type": "boolean" }
  }
}